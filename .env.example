TELEGRAM_TOKEN=
ANTHROPIC_API_KEY=

ADMIN_IDS=
GUEST_IDS=

DEFAULT_LANGUAGE=en
DATABASE_PATH=data/trading_intelligence.db
LOG_LEVEL=INFO

POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_BASE_URL=https://data-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com

COPY_INTEL_ENABLED=false
COPY_INTEL_READ_ONLY=true
COPY_PAPER_BANKROLL_USD=10000
COPY_POLL_INTERVAL_SECONDS=120
COPY_MAX_TRADE_AGE_MIN=30
COPY_MAX_EVENT_AGE_SECONDS=600
COPY_MIN_RESOLVED_TRADES=20
COPY_MIN_LIQUIDITY_USD=500
COPY_MAX_SLIPPAGE_PCT=0.02

# Crypto Intelligence V3.0.0a — public market data only; no trading keys
CRYPTO_INTEL_ENABLED=false
CRYPTO_INTEL_READ_ONLY=true
CRYPTO_MAX_QUOTE_AGE_SECONDS=30
CRYPTO_HTTP_TIMEOUT_SECONDS=8
CRYPTO_SYMBOLS=BTC/USDT,ETH/USDT
CRYPTO_BINANCE_BASE_URL=https://api.binance.com
CRYPTO_BYBIT_BASE_URL=https://api.bybit.com
CRYPTO_OKX_BASE_URL=https://www.okx.com
CRYPTO_BINGX_BASE_URL=https://open-api.bingx.com
CRYPTO_MEXC_BASE_URL=https://api.mexc.com
CRYPTO_KUCOIN_BASE_URL=https://api.kucoin.com

# Market Opportunity Intelligence V4.1 — paper-only foundation; no live detectors
MARKET_OPPORTUNITY_ENABLED=false
MARKET_OPPORTUNITY_AUTO_ALERTS_ENABLED=false
MARKET_OPPORTUNITY_READ_ONLY=true
# Optional V4.2 WTI adapters (never commit real keys)
EIA_API_KEY=
FRED_API_KEY=

HEALTH_MONITOR_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=300
HEALTH_ALERTS_ENABLED=true
HEALTH_FAILURE_THRESHOLD=3
HEALTH_RECOVERY_THRESHOLD=2
HEALTH_JOB_STALE_MULTIPLIER=2
HEALTH_AI_EXPLAINER_ENABLED=false

# Storage metrics (Phase 1) + explicit-path cleanup (Phase 2; non-destructive defaults)
STORAGE_LOGS_DIR=logs
STORAGE_CACHE_DIR=
STORAGE_PROOF_DIR=
STORAGE_ACTIVE_LOG_NAME=trading_intelligence.log
STORAGE_FILE_LOGGING_ENABLED=false
STORAGE_CLEANUP_ENABLED=false
STORAGE_CLEANUP_DRY_RUN=true
STORAGE_LOG_MAX_BYTES=10485760
STORAGE_LOG_BACKUP_COUNT=5
STORAGE_LOG_RETENTION_DAYS=14
STORAGE_CLEANUP_MIN_AGE_SECONDS=3600
STORAGE_CACHE_MIN_AGE_SECONDS=86400
STORAGE_PROOF_MIN_AGE_SECONDS=86400
STORAGE_CLEANUP_MAX_FILES_PER_RUN=100
STORAGE_CLEANUP_MAX_BYTES_PER_RUN=104857600
STORAGE_CLEANUP_LOCK_TTL_SECONDS=300
STORAGE_DEGRADED_FREE_BYTES=1073741824
STORAGE_CRITICAL_FREE_BYTES=268435456
STORAGE_DEGRADED_FREE_PERCENT=10
STORAGE_CRITICAL_FREE_PERCENT=5
STORAGE_DEGRADED_DB_GROWTH_BYTES=536870912
STORAGE_CRITICAL_DB_GROWTH_BYTES=2147483648
STORAGE_DEGRADED_WAL_BYTES=67108864
STORAGE_CRITICAL_WAL_BYTES=268435456

# Phase 4A online SQLite backup (absolute backup dir required; empty = unavailable)
STORAGE_BACKUP_DIR=
STORAGE_BACKUP_ENABLED=false
STORAGE_BACKUP_MAX_COUNT=7
STORAGE_BACKUP_MAX_AGE_DAYS=30
STORAGE_BACKUP_LOCK_TTL_SECONDS=600
STORAGE_BACKUP_MIN_FREE_BYTES=268435456
STORAGE_BACKUP_LABEL=ti_backup
STORAGE_BACKUP_CONFIRM_TTL_SECONDS=120
STORAGE_CLEANUP_CONFIRM_TTL_SECONDS=120

# Phase 3B verified-backup-gated SQLite retention pruning (disabled + dry-run by default)
STORAGE_RETENTION_PRUNE_ENABLED=false
STORAGE_RETENTION_PRUNE_DRY_RUN=true
STORAGE_RETENTION_PRUNE_MAX_ROWS_PER_RUN=500
STORAGE_RETENTION_PRUNE_MAX_ROWS_PER_POLICY=200
STORAGE_RETENTION_PRUNE_TIMEOUT_SECONDS=30
STORAGE_RETENTION_PRUNE_MAX_BACKUP_AGE_SECONDS=86400
STORAGE_RETENTION_PRUNE_LOCK_TTL_SECONDS=300
STORAGE_RETENTION_PRUNE_CONFIRM_TTL_SECONDS=120
STORAGE_RETENTION_PRUNE_STOP_ON_POLICY_FAILURE=true

WEATHER_GOV_BASE_URL=https://api.weather.gov

REPORT_TIMEZONE=America/Chicago
REPORT_TIMES=08:00,12:00,20:00
MAX_MARKETS_PER_SCAN=50
MAX_RESULTS_PER_REPORT=5
AUTO_REPORTS_ENABLED=false
AUTO_REPORT_REGIONS=USA,EUROPE,ASIA

PRIORITY_WEATHER_CITIES=Chicago,New York City,Miami,Atlanta,Seattle,Los Angeles
ANTHROPIC_RULE_FALLBACK_ENABLED=false

FORECAST_DIVERGENCE_THRESHOLD_F=3.0
FORECAST_DIVERGENCE_THRESHOLD_C=2.0
FORECAST_GRID_MAX_DISTANCE_KM=15.0
FORECAST_MIN_PROVIDERS=2

# V2.4.4 Live Edge — optional esports keys (empty = fail closed; never commit secrets)
# PandaScore token from https://app.pandascore.co/dashboard/main
# Free Fixtures plan: named running LoL/CS2/Dota series (1k req/hour). Not in-map gold/kills/rounds.
# In-map frames require paid Real-time Data (Basic) WebSockets — not used by this bot.
LIVE_ESPORTS_PROVIDER_API_KEY=
# Optional Riot LoL Esports persisted-gw x-api-key override (website client key, not a user secret)
LIVE_EDGE_LOLESPORTS_API_KEY=
